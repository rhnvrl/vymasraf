# GEMINI_API_KEY: Required for Gemini AI receipt/voice scanning.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public HTTPS URL of your server (required for PWA, GPS, camera, mic).
APP_URL="https://masraf.example.com"

# SESSION_SECRET: Long random secret string for user session tokens.
SESSION_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# === Linux MySQL Configuration ===
# Set DB_DIALECT=mysql (or provide MYSQL_HOST / MYSQL_DATABASE) on your Linux server:
DB_DIALECT="mysql"
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_DATABASE="masrafpro"
MYSQL_USER="masraf_user"
MYSQL_PASSWORD="MY_MYSQL_PASSWORD"
# Alternatively, a single connection URI:
# MYSQL_URL="mysql://masraf_user:MY_MYSQL_PASSWORD@127.0.0.1:3306/masrafpro"
